<div class="auth-shell">
    <section class="auth-card">
        <a class="auth-brand" href="/login">
            <span class="brand-mark">S</span>
            <span><strong>SHAF</strong><small>Digital Solution</small></span>
        </a>
        <p class="auth-kicker">ACCOUNT RECOVERY</p>
        <h1>Reset password.</h1>
        <p class="auth-copy">Gunakan username dan kode pemulihan yang disimpan di konfigurasi admin untuk membuat password baru.</p>

        <% if (error) { %><div class="auth-alert"><%= error %></div><% } %>
        <% if (message) { %><div class="auth-success"><%= message %></div><% } %>

        <form class="auth-form" method="post" action="/forgot-password">
            <label for="username">Username</label>
            <input id="username" name="username" type="text" autocomplete="username" placeholder="Username admin" required>

            <label for="recovery_code">Kode pemulihan</label>
            <input id="recovery_code" name="recovery_code" type="password" autocomplete="off" placeholder="Masukkan kode pemulihan" required>

            <label for="new_password">Password baru</label>
            <input id="new_password" name="new_password" type="password" autocomplete="new-password" placeholder="Minimal 8 karakter" minlength="8" required>

            <button class="btn" type="submit">Ubah password <span>↗</span></button>
        </form>

        <div class="auth-links">
            <a href="/login">Kembali ke login</a>
        </div>
    </section>
</div>
