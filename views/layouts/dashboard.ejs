<!DOCTYPE html>
<html lang="id">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>
        <%= title || 'Dashboard SHAF' %>
    </title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link
        href="https://fonts.googleapis.com/css2?family=Open+Sans:wght@400;500;600;700&family=Poppins:wght@400;500;600;700&display=swap"
        rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="<%= url('css/app.css') %>">
    <link rel="stylesheet" href="<%= url('css/dashboard.css') %>">
</head>

<body class="dashboard-body">
    <a class="skip-link" href="#mainContent">Lewati ke konten</a>
    <div class="app-shell">
        <aside class="sidebar" id="sidebar" aria-label="Navigasi utama">
            <div class="sidebar-top">
                <a class="brand" href="/dashboard" data-page="overview">
                    <span class="brand-mark">S</span>
                    <span class="brand-text"><strong>SHAF</strong><small>Digital Solution</small></span>
                </a>
                <button class="sidebar-close d-lg-none" id="sidebarClose" aria-label="Tutup menu">×</button>
            </div>

            <div class="sidebar-label">Workspace</div>
            <nav class="sidebar-nav">
                <a href="/dashboard" class="nav-item <%= activeSection === 'overview' ? 'active' : '' %>"
                    data-page="overview"><span class="nav-icon">⌂</span><span>Overview</span></a>
                <a href="/dashboard/landing" class="nav-item <%= activeSection === 'landing' ? 'active' : '' %>"
                    data-page="landing"><span class="nav-icon">◫</span><span>Landing Page</span></a>
                <a href="/dashboard/services" class="nav-item <%= activeSection === 'services' ? 'active' : '' %>"
                    data-page="services"><span class="nav-icon">✦</span><span>Layanan</span></a>
                <a href="/dashboard/portfolio" class="nav-item <%= activeSection === 'portfolio' ? 'active' : '' %>"
                    data-page="portfolio"><span class="nav-icon">▧</span><span>Portfolio</span></a>
                <a href="/dashboard/products" class="nav-item <%= activeSection === 'products' ? 'active' : '' %>"
                    data-page="products"><span class="nav-icon">□</span><span>Produk Digital</span></a>
                <a href="/dashboard/testimonials"
                    class="nav-item <%= activeSection === 'testimonials' ? 'active' : '' %>"
                    data-page="testimonials"><span class="nav-icon">“</span><span>Testimonial</span></a>
                <a href="/dashboard/messages" class="nav-item <%= activeSection === 'messages' ? 'active' : '' %>"
                    data-page="messages"><span class="nav-icon">✉</span><span>Pesan <% if ((unreadMessages || 0) > 0) { %><b
                            class="nav-badge"><%= unreadMessages %></b><% } %></span></a>
            </nav>

            <div class="sidebar-label mt-4">System</div>
            <nav class="sidebar-nav">
                <a href="/dashboard/faq" class="nav-item <%= activeSection === 'faq' ? 'active' : '' %>"
                    data-page="faq"><span class="nav-icon">?</span><span>FAQ</span></a>
                <a href="/dashboard/settings" class="nav-item <%= activeSection === 'settings' ? 'active' : '' %>"
                    data-page="settings"><span class="nav-icon">⚙</span><span>Pengaturan</span></a>
            </nav>

            <div class="sidebar-bottom">
                <div class="mini-profile">
                    <div class="avatar">PS</div>
                    <div><strong>
                            <%= user?.name || 'Admin' %>
                        </strong><small>Administrator</small></div>
                    <a class="profile-more" href="/logout" aria-label="Logout">↪</a>
                </div>
            </div>
        </aside>

        <div class="sidebar-backdrop" id="sidebarBackdrop"></div>

        <main class="main-area" id="mainContent">
            <header class="topbar">
                <div class="topbar-left">
                    <button class="menu-toggle d-lg-none" id="menuToggle"
                        aria-label="Buka menu"><span></span><span></span><span></span></button>
                    <div class="breadcrumb-wrap"><span class="breadcrumb-muted">SHAF Admin</span><span>/</span><strong
                            id="pageCrumb">Overview</strong></div>
                </div>
                <div class="topbar-actions">
                    <a href="/" class="view-site" target="_blank">Lihat website <span>↗</span></a>
                    <button class="icon-btn" aria-label="Notifikasi"><span class="notification-dot"></span>♢</button>
                    <div class="top-avatar">PS</div>
                </div>
            </header>

            <div class="mobile-page-title" id="mobilePageTitle"><%= pageTitle || "Overview" %></div>
            <%- body %>
        </main>
    </div>

    <div class="mobile-bottom-nav d-lg-none" aria-label="Navigasi cepat mobile">
        <button data-page-link="overview" class="<%= activeSection === "overview" ? "active" : "" %>"><span>⌂</span><small>Home</small></button>
        <button data-page-link="portfolio" class="<%= activeSection === "portfolio" ? "active" : "" %>"><span>▧</span><small>Karya</small></button>
        <button data-page-link="products" class="<%= activeSection === "products" ? "active" : "" %>"><span>□</span><small>Produk</small></button>
        <button data-page-link="messages" class="<%= activeSection === "messages" ? "active" : "" %>"><span>✉</span><small>Pesan</small><% if ((unreadMessages || 0) > 0) { %><b><%= unreadMessages %></b><% } %></button>
        <button id="mobileMore" type="button"><span>•••</span><small>Lainnya</small></button>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"></script>
    <script src="<%= url('js/dashboard.js') %>"></script>
</body>

</html>