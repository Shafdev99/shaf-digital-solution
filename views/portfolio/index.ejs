<header class="public-simple-header">
    <div class="container shaf-container">
        <a class="brand" href="/">
            <span class="brand-mark">S</span>
            <span class="brand-text"><strong>SHAF</strong><small>Digital Solution</small></span>
        </a>
        <nav>
            <a href="/">Beranda</a>
            <a href="/portfolio">Karya</a>
            <a href="/produk">Produk</a>
            <a class="btn btn-dark-shaf" href="/#kontak">Konsultasi <span>↗</span></a>
        </nav>
    </div>
</header>
<main class="public-list-page section-pad">
    <div class="container shaf-container">
        <div class="section-heading reveal">
            <div>
                <p class="section-kicker">PORTFOLIO</p>
                <h1>Semua karya yang<br><span>pernah kita kerjakan.</span></h1>
            </div>
            <p>Website, aplikasi, tools, automation, dan berbagai eksperimen yang layak ditampilkan.</p>
        </div>

        <% if (!portfolio.length) { %>
            <div class="cms-public-empty">Belum ada portfolio yang dipublikasikan.</div>
        <% } else { %>
            <div class="public-card-grid">
                <% portfolio.forEach((item) => { %>
                    <article class="public-project-card reveal">
                        <a href="/portfolio/<%= item.slug %>" class="public-card-image">
                            <% if (item.image) { %><img src="<%= item.image %>" alt="<%= item.title %>" loading="lazy"><% } else { %><div class="portfolio-placeholder"><span><%= item.title %></span></div><% } %>
                        </a>
                        <div class="public-card-body">
                            <div class="work-meta"><span><%= item.category %></span><span><%= item.featured ? 'Unggulan' : item.createdAt ? new Date(item.createdAt).getFullYear() : '' %></span></div>
                            <h2><a href="/portfolio/<%= item.slug %>"><%= item.title %></a></h2>
                            <p><%= item.description %></p>
                            <a class="text-link" href="/portfolio/<%= item.slug %>">Lihat detail <span>↗</span></a>
                        </div>
                    </article>
                <% }) %>
            </div>
        <% } %>
    </div>
</main>
<footer class="simple-public-footer"><div class="container shaf-container"><span>© 2026 SHAF Digital Solution</span><a href="/">Kembali ke beranda ↑</a></div></footer>